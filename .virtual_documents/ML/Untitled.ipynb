#data cleaning and preprocessing 

df_clean=df
df_clean.head()


df_clean.drop_duplicates(inplace=True)
df_clean.shape


df_clean.isnull().sum()


#encoding

df_clean['sex']=df_clean['sex'].map({"male":0,"female":1})
df_clean.head()


df_clean['smoker']=df_clean['smoker'].map({"no":0,"yes":1})
df_clean.head()


df_clean.rename(columns={
    'sex':'is_female',
    'smoker':'is_smoker'
},inplace=True)
df_clean.head()


#Now region has values  so now we will hot encoding

data_clean=pd.get_dummies(data=df_clean,columns=['region'],drop_first=False)
data_clean.head()


data_clean=data_clean.astype(int)
data_clean.head()


#Feature engineering and extraction


sea.histplot(data=data_clean['bmi'],bins=20)


#BMI has three categories overwheight , underwheight and healthy wheight

data_clean['bmi_cat']=pd.cut(
    data_clean['bmi'],
    bins=[0,18.5,24.9,29.9,float('inf')],
    labels=['under','healthy','over','obess']
)
data_clean.head()


data_clean=pd.get_dummies(data=data_clean['bmi_cat'])
data_clean.head()



